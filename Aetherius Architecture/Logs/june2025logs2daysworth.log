import music21 as m21

# Create the main stream which will hold all parts and global elements
final_stream = m21.stream.Stream()

# --- 1. Instrument Selection and Part Creation ---
# The composer envisions lush strings, warm woodwinds, harp, etc.
# From the allowed palette, we'll use:
# - Piano: To provide harmonic depth, warmth, and mimic harp-like arpeggios.
# - Violin: For lyrical, soaring lines, representing the 'endless horizon' strings.
# - Cello: For rich, warm bass and inner voices, contributing to the 'lush strings'.
# - Flute: For delicate, high-register melodies and 'shimmering' elements.
# - Clarinet: For warm, mid-range melodic lines and harmonic support.

# Create instrument objects
piano_instrument = m21.instrument.Piano()
violin_instrument = m21.instrument.Violin()
cello_instrument = m21.instrument.Violoncello()
flute_instrument = m21.instrument.Flute()
clarinet_instrument = m21.instrument.Clarinet()

# Create individual parts (streams) for each instrument
piano_part = m21.stream.Part()
violin_part = m21.stream.Part()
cello_part = m21.stream.Part()
flute_part = m21.stream.Part()
clarinet_part = m21.stream.Part()

# Assign instruments to their respective parts
piano_part.append(piano_instrument)
violin_part.append(violin_instrument)
cello_part.append(cello_instrument)
flute_part.append(flute_instrument)
clarinet_part.append(clarinet_instrument)

# Add all parts to the final_stream
final_stream.append(piano_part)
final_stream.append(violin_part)
final_stream.append(cello_part)
final_stream.append(flute_part)
final_stream.append(clarinet_part)

# --- 2. Global Musical Elements (Key, Initial Tempo, Initial Dynamics) ---
# Key Signature: E-flat Major for warmth and expansive awe.
key_signature = m21.key.Key('E-')
final_stream.insert(0, key_signature)

# Initial Tempo: Andante Sostenuto (slow and flowing)
initial_tempo = m21.tempo.MetronomeMark(text='Andante Sostenuto', number=60, referent='quarter')
final_stream.insert(0, initial_tempo)

# Initial Dynamics: piano (p) for serene contemplation
initial_dynamic = m21.dynamics.Dynamic('p')
final_stream.insert(0, initial_dynamic)

# --- 3. Musical Content (8-16 bars) ---
# We will create 12 bars, building in intensity and then receding.

# Bar 1-2: Serene contemplation, E-flat Major harmony, sustained
# Whole notes (quarterLength=4.0) for a calm, unhurried feel.
# Eb Major chord (Eb, G, Bb)
for _ in range(2): # Repeat for 2 bars
    piano_part.append(m21.chord.Chord(['Eb3', 'G3', 'Bb3', 'Eb4'], quarterLength=4.0))
    cello_part.append(m21.note.Note('Eb2', quarterLength=4.0))
    violin_part.append(m21.note.Note('G4', quarterLength=4.0))
    clarinet_part.append(m21.note.Note('Bb4', quarterLength=4.0))
    flute_part.append(m21.note.Note('Eb5', quarterLength=4.0))

# Bar 3: Subdominant harmony (Ab Major)
piano_part.append(m21.chord.Chord(['Ab3', 'C4', 'Eb4', 'Ab4'], quarterLength=4.0))
cello_part.append(m21.note.Note('Ab2', quarterLength=4.0))
violin_part.append(m21.note.Note('C5', quarterLength=4.0))
clarinet_part.append(m21.note.Note('Eb5', quarterLength=4.0))
flute_part.append(m21.note.Note('Ab5', quarterLength=4.0))

# Bar 4: Dominant (Bb7) resolving to Eb, with half-note movement
piano_part.append(m21.chord.Chord(['D3', 'F3', 'Ab3', 'C4'], quarterLength=2.0)) # Bb7 (no root, 1st inv)
cello_part.append(m21.note.Note('Bb2', quarterLength=2.0))
violin_part.append(m21.note.Note('F4', quarterLength=2.0))
clarinet_part.append(m21.note.Note('Ab4', quarterLength=2.0))
flute_part.append(m21.note.Note('D5', quarterLength=2.0))

piano_part.append(m21.chord.Chord(['Eb3', 'G3', 'Bb3', 'Eb4'], quarterLength=2.0)) # Eb Major resolution
cello_part.append(m21.note.Note('Eb2', quarterLength=2.0))
violin_part.append(m21.note.Note('G4', quarterLength=2.0))
clarinet_part.append(m21.note.Note('Bb4', quarterLength=2.0))
flute_part.append(m21.note.Note('Eb5', quarterLength=2.0))

# Bar 5-6: Adagio, mf - Gentle build-up, piano arpeggio imitation
# Current offset is 4 bars * 4 qL/bar = 16.0
adagio_tempo_mf = m21.tempo.MetronomeMark(text='Adagio', number=50, referent='quarter')
final_stream.insert(16.0, adagio_tempo_mf)
dynamic_mf = m21.dynamics.Dynamic('mf')
final_stream.insert(16.0, dynamic_mf)

# Bar 5: Piano plays a gentle arpeggio, other parts sustain (Cm harmony for modal inflection)
# Arpeggio (Ebmaj7) over 2 beats, then sustained chord for 2 beats
piano_part.append(m21.note.Note('Eb3', quarterLength=0.5))
piano_part.append(m21.note.Note('G3', quarterLength=0.5))
